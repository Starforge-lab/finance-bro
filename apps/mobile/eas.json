{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "pnpm": "12.9.1",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "pnpm": "12.9.1",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "friends": {
      "extends": "preview",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "preview" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "pnpm": "12.9.1",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
